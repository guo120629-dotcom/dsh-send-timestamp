{
  "name": "@local/dsh-send-timestamp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "meta": { "title": "Send Timestamp", "description": "Append the current time to every message you send." },
  "icon": "./icon.svg",
  "scripts": { "build": "node scripts/build.mjs", "test": "node --test \"test/*.test.mjs\"" },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.1" },
  "devDependencies": { "esbuild": "^0.24.0", "typescript": "^5.5.0", "@types/react": "^18.3.1", "@types/node": "^20.0.0" }
}
